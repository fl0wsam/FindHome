<androidx.core.widget.NestedScrollView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="580dp"
        android:id="@+id/frag_image_display"
        tools:context="com.SyracuseUniversity.jashwanthreddy.happynest.ImageDisplayFragment">

        <!-- TODO: Update blank fragment layout -->

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/propertydetail_image_view_pager"
            android:layout_width="357dp"
            android:layout_height="378dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="48dp">

        </androidx.viewpager.widget.ViewPager>

        <Button
            android:id="@+id/wanttocontactbutton"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_below="@+id/propertydetail_image_view_pager"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="#FF9800"
            android:text="Want to contact?"
            android:textColor="@android:color/white"
            android:textSize="20dp" />


    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
