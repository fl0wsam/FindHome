<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <RelativeLayout
        android:id="@+id/requirement_fragment_layout"
        android:layout_width="match_parent"
        android:layout_height="580dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true">

        <com.alimuzaffar.lib.widgets.AnimatedEditText
            android:id="@+id/locationtolive"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="50dp"
            android:hint="Where do you want to live?" />

        <TextView
            android:id="@+id/bedrroomnuber"
            android:layout_width="280dp"
            android:layout_height="30dp"
            android:layout_below="@+id/locationtolive"
            android:layout_alignStart="@+id/locationtolive"
            android:layout_alignLeft="@+id/locationtolive"
            android:layout_marginTop="13dp"
            android:text="Number Of Bedrooms"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/numberofbedroomsspinner1"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_alignTop="@+id/bedrroomnuber"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="48dp"
            android:layout_marginRight="48dp"></Spinner>

        <TextView
            android:id="@+id/propertybudget"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/bedrroomnuber"
            android:layout_alignStart="@+id/bedrroomnuber"
            android:layout_alignLeft="@+id/bedrroomnuber"
            android:layout_marginTop="19dp"
            android:text="Budget"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <com.alimuzaffar.lib.widgets.AnimatedEditText
            android:id="@+id/minbudget"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_below="@+id/propertybudget"
            android:layout_alignStart="@+id/propertybudget"
            android:layout_alignLeft="@+id/propertybudget"
            android:layout_marginTop="25dp"
            android:hint="Min"
            android:textSize="20dp" />

        <com.alimuzaffar.lib.widgets.AnimatedEditText
            android:id="@+id/maxbudget"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_alignBaseline="@+id/minbudget"
            android:layout_alignBottom="@+id/minbudget"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="23dp"
            android:layout_marginRight="23dp"
            android:hint="Max"
            android:textSize="20dp" />


        <CheckBox
            android:id="@+id/securitycheckbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/minbudget"
            android:layout_alignStart="@+id/minbudget"
            android:layout_alignLeft="@+id/minbudget"
            android:layout_marginTop="12dp" />

        <CheckBox
            android:id="@+id/furnishmentchechbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/securitycheckbox1"
            android:layout_alignStart="@+id/securitycheckbox1"
            android:layout_alignLeft="@+id/securitycheckbox1" />

        <CheckBox
            android:id="@+id/internetcheckbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/furnishmentchechbox1"
            android:layout_alignStart="@+id/furnishmentchechbox1"
            android:layout_alignLeft="@+id/furnishmentchechbox1" />

        <CheckBox
            android:id="@+id/recreationcheckbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/internetcheckbox1"
            android:layout_alignStart="@+id/internetcheckbox1"
            android:layout_alignLeft="@+id/internetcheckbox1" />

        <CheckBox
            android:id="@+id/parkingcheckbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/recreationcheckbox1"
            android:layout_alignStart="@+id/recreationcheckbox1"
            android:layout_alignLeft="@+id/recreationcheckbox1"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="3dp" />

        <TextView
            android:layout_width="200dp"
            android:layout_height="30dp"

            android:layout_above="@+id/furnishmentchechbox1"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="104dp"
            android:layout_marginLeft="104dp"
            android:layout_marginBottom="-2dp"
            android:text="Security"
            android:textColor="@android:color/black"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/furnishmenthead"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="102dp"
            android:layout_marginLeft="102dp"
            android:layout_marginBottom="246dp"
            android:text="Furnishment"
            android:textColor="@android:color/black"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/Internethead"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_alignStart="@+id/furnishmenthead"
            android:layout_alignLeft="@+id/furnishmenthead"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginBottom="216dp"
            android:text="Internet"
            android:textColor="@android:color/black"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/recreationhead"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="102dp"
            android:layout_marginLeft="102dp"
            android:layout_marginBottom="152dp"
            android:text="Recreation Services"
            android:textColor="@android:color/black"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/parkinghead"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_alignStart="@+id/Internethead"
            android:layout_alignLeft="@+id/Internethead"
            android:layout_alignBottom="@+id/parkingcheckbox1"
            android:layout_marginStart="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginBottom="33dp"
            android:text="Parking"
            android:textColor="@android:color/black"
            android:textSize="20dp" />

        <Button
            android:id="@+id/searchbutton"
            android:layout_width="140dp"
            android:layout_height="50dp"


            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="11dp"
            android:background="#FF9800"
            android:text="Search"
            android:textColor="@android:color/white" />

    </RelativeLayout>
</RelativeLayout>