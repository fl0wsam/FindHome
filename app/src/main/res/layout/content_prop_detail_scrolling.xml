<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_margin="@dimen/text_margin"
         android:text="@string/large_text" />-->

    <RelativeLayout
        android:id="@+id/contact_info_layout"
        android:layout_width="match_parent"
        android:layout_height="580dp">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/beadroomhead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="221dp"
            android:layout_marginRight="221dp"
            android:text="About home "
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/beadroomhead"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/pricehead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="212dp"
            android:layout_marginRight="212dp"
            android:text="Bedrooms"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pricehead"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"


            android:layout_marginStart="48dp"
            android:layout_marginLeft="48dp"
            android:layout_marginTop="102dp"
            android:text="Price"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/amenitieshead"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/descriptiondata"
            android:layout_marginTop="11dp"
            android:text="Amenities"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/descriptiondata"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="98dp"
            android:layout_marginRight="98dp"
            android:text="Amenities"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/pricebox"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_alignTop="@+id/pricehead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/bedrrombox"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_alignTop="@+id/beadroomhead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/descriptiondata"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView3"
            android:layout_marginLeft="40dp"
            android:textColor="@color/white"
            android:textSize="20dp"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/amenitiesdata"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/amenitieshead"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            tools:visibility="invisible" />

        <Button
            android:id="@+id/button2"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_below="@+id/cityindetailhomelayout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:background="#FF9800"
            android:text="Continue"
            android:textColor="@android:color/white"
            tools:visibility="invisible" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_below="@+id/amenitiesdata"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="219dp"
            android:layout_marginRight="219dp"
            android:text="Address"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/addressline1indetailhomelayout"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView4"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="182dp"
            android:layout_marginLeft="182dp"
            android:layout_marginTop="19dp"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/addressline2indetailhomelayout"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/addressline1indetailhomelayout"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="182dp"
            android:layout_marginLeft="182dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/cityindetailhomelayout"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/addressline2indetailhomelayout"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="179dp"
            android:layout_marginLeft="179dp"
            android:layout_marginTop="-3dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:textColor="@color/white"
            android:textSize="20dp" />
    </RelativeLayout>

</androidx.core.widget.NestedScrollView>
