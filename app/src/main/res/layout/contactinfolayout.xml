<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/contact_info_layout"
        android:layout_width="match_parent"
        android:layout_height="580dp">


        <TextView
            android:id="@+id/emailhead"
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:layout_below="@+id/namehead"
            android:layout_alignStart="@+id/namehead"
            android:layout_alignLeft="@+id/namehead"
            android:layout_marginTop="13dp"
            android:text="Email"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/namehead"
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="87dp"
            android:layout_marginLeft="87dp"
            android:layout_marginTop="32dp"
            android:text="Name"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contacthead"
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:layout_below="@+id/emailhead"
            android:layout_alignStart="@+id/emailhead"
            android:layout_alignLeft="@+id/emailhead"
            android:layout_marginTop="19dp"
            android:text="Mobile"
            android:textColor="#FF9800"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/namebox"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignTop="@+id/namehead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="114dp"
            android:layout_marginRight="114dp"
            android:text="Name"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emailbox"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignTop="@+id/emailhead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="106dp"
            android:layout_marginRight="106dp"
            android:text="EmailId"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mobiledata"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignBaseline="@+id/contacthead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="110dp"
            android:layout_marginRight="110dp"
            android:text="Mobile"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/savetocontactsbutton"
            android:layout_width="70dp"
            android:layout_height="70dp"

            android:layout_below="@+id/contacthead"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="49dp"
            android:layout_marginEnd="121dp"
            android:layout_marginRight="121dp" />

        <ImageButton
            android:id="@+id/callownerbutton"
            android:layout_width="70dp"
            android:layout_height="70dp"

            android:layout_alignTop="@+id/savetocontactsbutton"

            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="117dp"
            android:layout_marginLeft="117dp"
            android:layout_marginTop="-1dp"
            android:layout_marginEnd="33dp"
            android:layout_marginRight="33dp"
            android:layout_toStartOf="@+id/savetocontactsbutton"
            android:layout_toLeftOf="@+id/savetocontactsbutton" />

    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
