<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/createAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/Differentlogin"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp"
        android:text="Welcome to FindHome"
        android:textColor="#FF9800"
        android:textSize="24dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/createAccount1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/createAccount"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp"
        android:text="First time users,click on Create User"
        android:textColor="#FF9800"
        android:textSize="20dp" />


    <com.alimuzaffar.lib.widgets.AnimatedEditText
        android:id="@+id/edit_text_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edit_text_email"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="-7dp"
        android:layout_marginTop="61dp"
        android:layout_marginEnd="-12dp"
        android:background="@android:color/white"
        android:hint="Enter your password"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="#616161"
        android:textColorHint="#AEAEAE"
        android:textSize="15.3sp" />

    <com.alimuzaffar.lib.widgets.AnimatedEditText
        android:id="@+id/edit_text_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/createAccount1"
        android:layout_alignParentStart="true"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="51dp"
        android:background="@android:color/white"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:nextFocusDown="@+id/edit_text_password"
        android:padding="14dp"
        android:textColor="#616161"
        android:textColorHint="#AEAEAE"
        android:textSize="15.3sp" />

    <Button
        android:id="@+id/createbutton"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/loginbutton"
        android:layout_alignEnd="@+id/createAccount1"
        android:layout_alignBottom="@+id/loginbutton"
        android:layout_marginLeft="40dp"
        android:background="#FF9800"
        android:text="Create User"
        android:textColor="@android:color/white" />


    <TextView
        android:id="@+id/loginTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/sign_in_button"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="19dp"
        android:text="Or Login With Google"
        android:textColor="#FF9800"
        android:textSize="20dp" />

    <Button
        android:id="@+id/loginbutton"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/loginTV"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="32dp"
        android:layout_toStartOf="@+id/createbutton"
        android:background="#FF9800"
        android:text="Login"
        android:textColor="@android:color/white" />

    <com.google.android.gms.common.SignInButton
        android:id="@+id/sign_in_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="81dp"
        app:buttonSize="wide"
        app:colorScheme="dark" />


</RelativeLayout>
